APP_NAME=Task Tracker API
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Database (Postgres via docker compose: infra/docker-compose.yml)
DATABASE_URL=postgresql+psycopg://taskuser:taskpass@localhost:5432/tasktracker
DATABASE_ECHO=false

# Authentication
# Use a long random value (32+ characters) in real environments.
JWT_SECRET_KEY=replace-with-a-long-random-secret
